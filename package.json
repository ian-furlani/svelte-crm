		"@types/electron": "^1.4.38",
		"@types/node": "^24",
		"electron": "^41.2.0",
		"electron-builder": "^26.8.1",
		"eslint": "^10.0.3",
		"eslint-plugin-svelte": "^3.15.2",
		"globals": "^17.4.0",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.2",
		"tailwindcss": "^4.1.18",
